menu "CoffeeProbe thermocouple"

    choice PROBE_TC_CHIP
        prompt "Thermocouple converter"
        default PROBE_TC_MAX31855

        config PROBE_TC_MAX31855
            bool "MAX31855"

        config PROBE_TC_MAX6675
            bool "MAX6675"
    endchoice

    config PROBE_TC_GROUNDED
        bool "Grounded probe (MAX31855)"
        default n
        help
            Enable only for a probe tip that touches the grounded roaster body.
            In this mode a short to ground is accepted, so a crushed cable that
            shorts both leads to grounded metal is NOT detected and reads close to
            the electronics temperature. This and the converter choice are the
            factory default; the settings menu overrides them (D-012).

endmenu
